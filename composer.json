{
    "name": "amelaye/biotools",
    "authors": [
        {
            "name": "Amelie DUVERNET",
            "email": "amelieonline@gmail.com",
            "homepage": "https://www.amelieonline.net",
            "role": "Developer"
        }
    ],
    "license": "GPL-2.0-only",
    "type": "symfony-bundle",
    "description": "Symfony forms and services for the BioPHP minitools",
    "keywords": ["symfony", "biology", "php", "bioinformatics", "form"],
    "homepage": "http://www.amelayes-biophp.net",
    "repositories": [
        {
            "type": "path",
            "url": "../biophp/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Amelaye\\BioTools\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "Tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "amelaye/biophp": "@dev",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/form": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/options-resolver": "^7.4",
        "symfony/validator": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "sort-packages": true
    }
}
